{#- Template: buildspec.yml.j2 #}
{%- if data.config.provider == 'aws' %}
version: 0.2

env:
  shell: bash
  variables:
    LAUNCH_CONTEXT: "ci/aws/codepipeline"

phases:
  build:
    commands:
      - eval "${LAUNCH_ACTION}"
  post_build:
    commands:
      - |
        . ${CODEBUILD_SRC_DIR}/set_vars.sh
        GITHUB_TOKEN=$(launch github auth application --application-id-parameter-name "${GITHUB_APPLICATION_ID}" --installation-id-parameter-name "${GITHUB_INSTALLATION_ID}" --signing-cert-secret-name "${GITHUB_SIGNING_CERT_SECRET_NAME}") 
        if (( CODEBUILD_BUILD_SUCCEEDING == 0 )); then
          launch github commit status set --status "failure" --description "Build failed." --repository-name "${GIT_REPO}" --organization "${GIT_ORG}" --commit-hash "${MERGE_COMMIT_ID}" --target-url "${CODEBUILD_BUILD_URL}" --context "${LAUNCH_CONTEXT}"
        elif [[ "${IS_PIPELINE_LAST_STAGE}" = "true" ]]; then
          launch github commit status set --status "success" --description "Build succeeded." --repository-name "${GIT_REPO}" --organization "${GIT_ORG}" --commit-hash "${MERGE_COMMIT_ID}" --target-url "${CODEBUILD_BUILD_URL}" --context "${LAUNCH_CONTEXT}"
        else
          launch github commit status set --status "pending" --description "Build pending." --repository-name "${GIT_REPO}" --organization "${GIT_ORG}" --commit-hash "${MERGE_COMMIT_ID}" --target-url "${CODEBUILD_BUILD_URL}" --context "${LAUNCH_CONTEXT}"
        fi
{%- endif %}
